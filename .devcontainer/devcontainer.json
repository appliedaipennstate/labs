{
  "name": "Applied AI Labs",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "sudo ln -sf \"$(pwd)/bin/labs\" /usr/local/bin/labs",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "WELCOME.md"
      ]
    },
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "workbench.editorAssociations": {
          "**/WELCOME.md": "vscode.markdown.preview.editor"
        },
        "workbench.secondarySideBar.defaultVisibility": "visible",
        "chat.agent.enabled": true,
        "git.autofetch": false
      }
    }
  }
}
